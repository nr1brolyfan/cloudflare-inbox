PUBLIC_ORIGIN=https://inbox.example.com
AUTH_EMAIL_FROM=auth@example.com
MAILBOX_BOOTSTRAP_OWNER_EMAIL_ALLOWLIST=["owner@example.com"]
MAILBOX_INITIAL_ADDRESS=inbox@example.com
MAILBOX_ARCHIVE_RECIPIENT=archive@example.net
AUTH_SESSION_SECRET=<generate-32-byte-base64url-session-secret>
AUTH_CHALLENGE_SECRET=<generate-32-byte-base64url-challenge-secret>
AUTH_PRIVACY_SECRET=<generate-32-byte-base64url-privacy-secret>
# Optional local OTLP/HTTP collector, for example Motel:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:27686

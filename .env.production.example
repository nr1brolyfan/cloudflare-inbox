# Copy to the ignored .env.production and replace every angle-bracket placeholder.
# Keep this file private. Generate each secret independently, for example:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PUBLIC_ORIGIN=https://mail.szymondlugolecki.com
AUTH_EMAIL_FROM=auth@szymondlugolecki.com
MAILBOX_BOOTSTRAP_OWNER_EMAIL_ALLOWLIST=["<external-owner-address>"]
MAILBOX_INITIAL_ADDRESS=szymon@szymondlugolecki.com
MAILBOX_ARCHIVE_RECIPIENT=<verified-external-gmail-archive-address>
JOB_MAIL_INBOUND_ROUTE_ENABLED=false
JOB_MAIL_SHARED_ROUTING_STATE_CONFIRMED=<set-to-disabled-drop-reviewed-after-manual-inventory>
AUTH_SESSION_SECRET=<43-character-base64url-secret-1>
AUTH_CHALLENGE_SECRET=<43-character-base64url-secret-2>
AUTH_PRIVACY_SECRET=<43-character-base64url-secret-3>

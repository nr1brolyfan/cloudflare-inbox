+            );
+          }
+          quote = undefined;
+        } else quotedValue += current;
+      } else if (current === quote && next === quote) {
+        output += next;
+        quotedValue += current;
+        index += 1;
+      } else if (current === quote) {
+        const following = nextSqlCodeIndex(sql, index + 1);
+        if (
+          quotedValue.toLowerCase() === "temp" &&
+          sql[following] === "."
+        ) {
+          throw new Error("TEMP schema references are incompatible with D1 import");
+        }
+        quote = undefined;
+      } else quotedValue += current;
+      continue;
+    }
+    if (current === "-" && next === "-") {
+      output += current + next;
+      lineComment = true;
+      index += 1;
+      continue;
+    }
+    if (current === "/" && next === "*") {
+      output += current + next;
+      blockComment = true;
+      index += 1;
+      continue;
+    }
+    if (["'", '"', "`", "["].includes(current)) {
+      output += current;
+      quotedValue = "";
+      quote = current === "[" ? "]" : (current as "'" | '"' | "`");
+      continue;
+    }
+    if (/[A-Z_]/iu.test(current)) {

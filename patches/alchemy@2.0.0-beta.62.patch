+      lineComment = true;
+      index += 1;
+      continue;
+    }
+    if (current === "/" && next === "*") {
+      consumeWord();
+      blockComment = true;
+      index += 1;
+      continue;
+    }
+    if (current === "'" || current === '"' || current === "`") {
+      consumeWord();
+      statementToken = true;
+      quote = current;
+      continue;
+    }
+    if (current === "[") {
+      consumeWord();
+      statementToken = true;
+      quote = "]";
+      continue;
+    }
+    if (/[A-Za-z0-9_]/u.test(current)) {
+      word += current;
+      continue;
+    }
+    consumeWord();
+    if (current !== ";") continue;

+      const following = nextSqlCodeIndex(sql, end);
+      if (identifier.toLowerCase() === "temp" && sql[following] === ".") {
+        throw new Error("TEMP schema references are incompatible with D1 import");
+      }
+      output += scratchNames.get(identifier.toLowerCase()) ?? identifier;
+      index = end - 1;
+      continue;
+    }
+    output += current;
+  }
+  return output;
+};
+
+const stripSqlComments = (sql: string): string => {
+  let output = "";
+  let quote: "'" | '"' | "`" | "]" | undefined;
+  let lineComment = false;
+  let blockComment = false;
+  for (let index = 0; index < sql.length; index += 1) {
+    const current = sql[index]!;
+    const next = sql[index + 1];
+    if (lineComment) {
+      if (current === "\n") {
+        output += current;
+        lineComment = false;
+      }
+      continue;
+    }
+    if (blockComment) {
+      if (current === "*" && next === "/") {
+        output += " ";
+        blockComment = false;
+        index += 1;
+      }
+      continue;
+    }
+    if (quote !== undefined) {
+      output += current;
+      if (quote === "]") {
+        if (current === "]" && next === "]") output += sql[++index]!;
+        else if (current === "]") quote = undefined;
+      } else if (current === quote && next === quote) {
+        output += sql[++index]!;
+      } else if (current === quote) quote = undefined;
+      continue;
+    }
+    if (current === "-" && next === "-") {
+      lineComment = true;
+      index += 1;
+      continue;
+    }
+    if (current === "/" && next === "*") {
+      blockComment = true;
+      index += 1;
+      continue;
+    }
+    output += current;
+    if (["'", '"', "`", "["].includes(current)) {
+      quote = current === "[" ? "]" : (current as "'" | '"' | "`");
+    }
+  }
+  return output;
+};

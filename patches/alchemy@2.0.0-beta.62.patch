+    return init.result
+      ? {
+          _tag: "complete",
+          result: {
+            filename,
+            numQueries: init.result.numQueries ?? 0,
+          },
+        }
+      : { _tag: "error", message: "D1 import complete result missing" };
+  }
+  if (init.status === "error") {
+    return {
+      _tag: "error",
+      message: init.error ?? "D1 import failed",
+    };

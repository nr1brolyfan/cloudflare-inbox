+/** Compile migration scratch objects for D1 import without changing source files. */
+export const compileD1ImportSql = (sql: string, migrationId: string): string => {
+  const statements = splitSqlStatements(sql);
+  const scratchNames = new Map<string, string>();
+  for (const statement of statements) {
+    const match = tempObject.exec(statement);
+    if (
+      anyTempDeclaration.test(stripSqlComments(statement)) &&
+      match === null
+    ) {
+      throw new Error("Unsupported TEMP object declaration for D1 import");
+    }
+    if (match?.[4] !== undefined) {
+      scratchNames.set(match[4].toLowerCase(), `__d1_scratch_${match[4]}`);
+    }
+  }
+  if (scratchNames.size > 0 && !scratchMigrationIds.has(migrationId)) {
+    throw new Error(`TEMP objects are not approved for migration ${migrationId}`);
+  }
+  return statements
+    .map((statement) => {
+      const guardedStatement = stripSqlComments(statement);
+      if (
+        unsupportedCommand.test(guardedStatement) ||
+        schemaWrite.test(guardedStatement) ||
+        cteSchemaWrite.test(guardedStatement)
+      ) {
+        throw new Error("Migration statement is incompatible with D1 import");
+      }
+      const compiled = rewriteScratchIdentifiers(
+        statement.replace(tempObject, "$1$2$3$4"),
+        scratchNames,
+      );
+      return compiled.endsWith(";") ? compiled : `${compiled}\n;`;
+    })
+    .join("\n");
+};

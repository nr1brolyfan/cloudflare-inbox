+      if (current === "\n") lineComment = false;
+      continue;
+    }
+    if (blockComment) {
+      output += current;
+      if (current === "*" && next === "/") {
+        output += next;
+        blockComment = false;
+        index += 1;
+      }
+      continue;
+    }
+    if (quote !== undefined) {
+      output += current;
+      if (quote === "]") {
+        if (current === "]" && next === "]") {
+          output += next;
+          quotedValue += current;
+          index += 1;
+        } else if (current === "]") {
+          const following = nextSqlCodeIndex(sql, index + 1);
+          if (quotedValue.toLowerCase() === "temp" && sql[following] === ".") {
+            throw new Error(

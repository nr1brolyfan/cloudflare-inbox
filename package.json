{
  "name": "cloudflare-inbox",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "ALCHEMY_STATE=local alchemy dev",
    "dev:vite": "vite dev --port 3000",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "generate:auth-migrations": "bun scripts/write-auth-migrations.ts",
    "check:auth-migrations": "bun scripts/write-auth-migrations.ts --check",
    "generate:auth-schema": "bun scripts/write-auth-schema.ts",
    "check:auth-schema": "bun scripts/write-auth-schema.ts --check",
    "check:no-raw-sql": "bun scripts/check-no-raw-sql.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --passWithNoTests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check": "bun run check:auth-migrations && bun run check:auth-schema && bun run check:no-raw-sql && bun run format:check && bun run lint"
  },
  "dependencies": {
    "@effect-auth/core": "0.1.0-alpha.19",
    "@effect/platform-bun": "4.0.0-beta.98",
    "@effect/sql-d1": "4.0.0-beta.98",
    "@effect/sql-sqlite-do": "4.0.0-beta.98",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "alchemy": "2.0.0-beta.62",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.98",
    "effect-qb": "4.0.0-beta.98",
    "lucide-react": "^0.577.0",
    "parse5": "8.0.1",
    "postal-mime": "2.7.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260717.1",
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/sql-sqlite-node": "4.0.0-beta.98",
    "@effect/vitest": "4.0.0-beta.98",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^28.1.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "^6.0.2",
    "ultracite": "7.9.4",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "@effect/vitest": "4.0.0-beta.98"
  },
  "packageManager": "bun@1.3.14"
}
